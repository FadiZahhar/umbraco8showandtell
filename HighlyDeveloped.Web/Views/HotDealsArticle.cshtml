@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.HotDealsArticle>
	@using ContentModels = Umbraco.Web.PublishedModels;
	@using Umbraco.Core.PropertyEditors.ValueConverters;
	@{
	Layout = "main.cshtml";
	}



@{
    var title = Model.Value<string>("title");
    var image = Model.Value<ImageCropperValue>("productImage");
    var imageUrl = image?.Src;
    var rating = Model.Value<decimal?>("ratings") ?? 0;
    var sizes = Model.Value<string>("size");
    var oldPrice = Model.Value<decimal?>("oldPrice");
    var newPrice = Model.Value<decimal?>("newPrice");
    var colors = Model.Value<IEnumerable<IPublishedContent>>("colors");
    var description = Model.Value<string>("description");
}






<div class="container my-4 product-card">
            <div class="row"> <!-- Image Section -->
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-3 p-0"> <img src="assets/img/tshirt-1.jpg" class="img-thumbnail thumb-img" alt="T-shirt 1"><img src="assets/img/tshirt-2.jpg" class="img-thumbnail thumb-img" alt="T-shirt 2"><img src="assets/img/tshirt-3.jpg" class="img-thumbnail thumb-img" alt="T-shirt 3"> </div>
                        <div class="col-9 ps-0"> <img id="mainImage" src="assets/img/tshirt-main.jpg" class="product-img mb-3" alt="Main T-shirt"> </div>
                    </div>
                </div> <!-- Product Info Section -->
                <div class="col-md-6">
                    <h4>@title</h4>
                    <div class="d-flex justify-content-between">
                        <p class="text-muted">By Essence Company</p>
                        <p><span class="rating-star">★</span> 4.5</p>
                    </div>
                    <p class="color-title"><strong>Color:</strong></p>
                    <div class="mb-3"> <span class="color-circle" style="background-color: #ffffff"></span><span class="color-circle" style="background-color: #4a4a4a"></span><span class="color-circle" style="background-color: #f5c242"></span><span class="color-circle" style="background-color: #c1442c"></span> </div>
                    <p><strong>Size:</strong></p>
                    <div class="btn-group mb-3 size"> <button type="button" class="btn btn-outline-secondary btn-sm">@sizes</button>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-6">
                            <h5 class="mb-3 price">$ 10.99 <small class="text-muted">(20% discount)</small></h5>
                        </div>
                        <div class="col-6 text-end text-yellow">
                            <p class="mb-0"><strong>6 Pieces Left</strong></p>
                        </div>
                    </div> <button class="btn btn-add btn-lg mb-3">Add to Cart</button>
                    <p class="desc-small"><strong>Return Policy:</strong> 2 weeks return policy</p>
                    <p class="desc-small"><strong>Customer Service:</strong> 24/7 online customer service</p>
                </div>
                <div class="col-12 pt-5">
                    <h4>Description</h4>
                    <p>Elevate your casual style with the Denim Essence Men&#39;s 4-Piece Solid Color Basic Textured Stretch T-Shirt set. Designed for comfort and versatility, these premium textured stretch tees offer a sleek fit and timeless appeal. The Denim Essence Men&#39;s 4-Piece T-Shirt set has garnered over 5,000 glowing reviews, making it a top-rated choice among casual wear enthusiasts. Available in bold red, classic black, neutral gray, and trendy mustard yellow.</p>
                    <p><strong>Material:</strong> 100% Denim Cotton</p>
                    <p><strong>Washing Method:</strong> Dry/Steam Wash Only</p>
                    <p class="text-muted">Made in U.A.E</p>
                </div>
            </div>
        </div>