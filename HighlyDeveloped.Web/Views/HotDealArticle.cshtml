@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.HotDealArticle>
@using ContentModels = Umbraco.Web.PublishedModels;
@using Umbraco.Core.PropertyEditors.ValueConverters;
@{
	Layout = "main.cshtml";
}




@{
    var maintitleProduct = Model.Value<string>("title");
    var mainImageProduct = Model.Value<ImageCropperValue>("productImage");
    var mainthumbUrl = mainImageProduct.Src + mainImageProduct.GetCropUrl("Main");
    var mainrating = Model.Value<decimal?>("ratings") ?? 0;
    var mainsizes = Model.Value<string>("size");
    var mainoldPrice = Model.Value<decimal?>("oldPrice");
    var mainnewPrice = Model.Value<decimal?>("newPrice");

                                    
    var mainproductSizes = Model.Value<IEnumerable<IPublishedElement>>("productSizesNestedContent");
    var mainsizeLabels = mainproductSizes?.Select(x => x.Value<string>("size")) ?? Enumerable.Empty<string>();


    var mainColorsimages = Model.Value<IEnumerable<IPublishedContent>>("colors");
    
    var mainDescription = Model.Value<string>("description").StripHtml();
    var washingMethod = Model.Value<string>("washingMethod");
    var material = Model.Value<string>("material");
    var madeIn = Model.Value<string>("madeIn");
    var piecesLeft = Model.Value<string>("piecesLeft");
    
    
    
    var relatedArticles = Model.Value<IList<IPublishedContent>>("articleRelatedContent");
}






<div class="container my-4 product-card">
            <div class="row"> <!-- Image Section -->
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-3 p-0"> 
                        <img src="@mainImageProduct" class="img-thumbnail thumb-img" alt="T-shirt 1">
                        <img src="@mainImageProduct" class="img-thumbnail thumb-img" alt="T-shirt 2">
                        <img src="@mainImageProduct" class="img-thumbnail thumb-img" alt="T-shirt 3"> </div>
                        <div class="col-9 ps-0"> <img id="mainImage" src="@mainImageProduct" class="product-img mb-3" alt="Main T-shirt"> </div>
                    </div>
                </div> <!-- Product Info Section -->
                <div class="col-md-6">
                    <h4>@maintitleProduct</h4>
                    <div class="d-flex justify-content-between">
                        <p class="text-muted">By Essence Company</p>
                        <p><span class="rating-star">★</span> @mainrating</p>
                    </div>
                    <p class="color-title"><strong>Color:</strong></p>
                    <div class="mb-3"> <span class="color-circle" style="background-color: #ffffff"></span><span class="color-circle" style="background-color: #4a4a4a"></span><span class="color-circle" style="background-color: #f5c242"></span><span class="color-circle" style="background-color: #c1442c"></span> </div>
                    <p><strong>Size:</strong></p>
                    <div class="btn-group mb-3 size">
                         @if (mainsizeLabels != null && mainsizeLabels.Any())
                        {
                            foreach (var sizeItem in mainproductSizes)
                            {
                                var sizeLabel = sizeItem.Value<string>("size");
                                <button type="button" class="btn btn-outline-secondary btn-sm">@sizeLabel</button>
                            }
                        }
                    </div>
                    <div class="row align-items-center">
                        <div class="col-6">
                            <h5 class="mb-3 price">$ @mainnewPrice <small class="text-muted">(20% discount)</small></h5>
                        </div>
                        <div class="col-6 text-end text-yellow">
                            <p class="mb-0"><strong>6 Pieces Left</strong></p>
                        </div>
                    </div> <button class="btn btn-add btn-lg mb-3">Add to Cart</button>
                    <p class="desc-small"><strong>Return Policy:</strong> 2 weeks return policy</p>
                    <p class="desc-small"><strong>Customer Service:</strong> 24/7 online customer service</p>
                </div>
                <div class="col-12 pt-5">
                    <h4>Description</h4>
                    <p> @mainDescription </p>
                    <p><strong>Material: .StripHtml()</strong> @material</p>
                    <p><strong>Washing Method: </strong>@washingMethod</p>
                    <p class="text-muted">@madeIn</p>
                </div>
            </div>
        </div>
        
        
        <!--RELATED PRODUCTS--->
        @if(relatedArticles != null && relatedArticles.Count > 0){
        <section id="hot-deals" class="hot-deals section">
            <div class="container hot-deals__head">
                <div class="row">
                    <div class="col text-center">
                        <h1>Related Products</h1>
                    </div>
                </div>
            </div>
             <div class="container" data-aos="fade-up" data-aos-delay="100">
                    <div class="swiper init-swiper">
                        <script type="application/json" class="swiper-config">
                            {
                                "loop": true,
                                "speed": 600,
                                "autoplay": { "delay": 5000 },
                                "spaceBetween": 16,
                                "slidesPerView": 1,
                                "breakpoints": {
                                    "480": { "slidesPerView": 1.2 },
                                    "768": { "slidesPerView": 2 },
                                    "992": { "slidesPerView": 4 },
                                    "1200": { "slidesPerView": 5 }
                                },
                                "pagination": { "el": ".swiper-pagination", "type": "bullets", "clickable": true },
                                "navigation": { "nextEl": ".swiper-button-next", "prevEl": ".swiper-button-prev" }
                            }
                        </script>
    
                        <div class="swiper-wrapper">
                            @foreach (var item in relatedArticles)
                            {
                        var image = item.Value<ImageCropperValue>("productImage");
                        var thumbUrl = image.Src + image.GetCropUrl("Thumb");

                        var title = item.Value("title");
                        var rating = item.Value("ratings") ?? 0;
                        var sizes = item.Value<string>("size");
                        var oldPrice = item.Value<decimal?>("oldPrice");
                        var newPrice = item.Value<decimal?>("newPrice");

                        <!--SIZES NESTED CONTENT-->
                        <!--var productSizes = item.Value<IEnumerable<IPublishedElement>>("productSizesNestedContent");-->
                        var productSizes = item.Value<IEnumerable<IPublishedElement>>("productSizesNestedContent");
                        var sizeLabels = productSizes?.Select(x => x.Value<string>("size")) ?? Enumerable.Empty<string>();



                        <!--PRODUCTS COLOR -->
                        var images = item.Value<IEnumerable<IPublishedContent>>("colors");


                        <div class="swiper-slide">
                            <a href="@item.Url" style="text-decoration:none; color:inherit;">
                            <article class="deal-card">
                                <div class="card">
                                    <img src="@thumbUrl" class="card-img" alt="@title" />
                                    <div class="card-img-overlay card-text-style">
                                        <div class="row mb-1">
                                            <div class="col text-start">
                                                <h5>@title</h5>
                                            </div>
                                            <div class="col text-end">
                                                <div class="rating">

                                                                <img src="/media/xaxj1pgm/ratings.png" alt="" />


                                                    <span>@rating</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-1">
                                            <div class="col text-start">
                                                   @if (productSizes != null && productSizes.Any())
                                                   {
                                                     <p>@string.Join(" - ", sizeLabels)</p>
                                                   }
                                            </div>
                                            <div class="col text-end old-price">
                                                <p>$@oldPrice</p>
                                            </div>
                                        </div>

                                        <div class="row">

                                                @if (images != null)
                                                    {

                                                            <div class="col text-start colors">

                                                                @foreach (var img in images)
                                                                {

                                                                        <img src="@img.Url()" alt="@img.Name" />

                                                                }


                                                        </div>
                                                    }
                                                <div class="col new-price text-end">
                                                    <span>$@newPrice</span>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                            </a>
                        </div>
                    }
                        </div>
    
                        <div class="hot-deals__controls">
                            <div class="swiper-pagination"></div>
                            <div class="swiper-button-prev"></div>
                            <div class="swiper-button-next"></div>
                        </div>
                    </div>
                </div>
            </section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".init-swiper").forEach(function (swiperEl) {
            const configScript = swiperEl.querySelector(".swiper-config");
            if (!configScript) return;

            try {
                const config = JSON.parse(configScript.textContent);
                new Swiper(swiperEl, config);
            } catch (e) {
                console.error("Failed to parse Swiper config:", e);
            }
        });
    });
</script>

        }
        