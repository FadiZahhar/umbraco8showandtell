@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.Search>
    @using ContentModels = Umbraco.Web.PublishedModels;
    @using Examine
    @using Umbraco.Web

    @{
    Layout = "main.cshtml";

    var heroImage = Model.Value<IPublishedContent>
        ("heroImage")?.Url ?? "";
        var heroOverlayColour = Model.Value<string>
            ("heroOverlayColour");

            var searchQuery = Request.QueryString["q"];
            IEnumerable<PublishedSearchResult>
                searchResults = null;
                var resultsCount = 0;

                if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                searchResults = Umbraco.ContentQuery
                .Search(searchQuery, string.Empty, "InternalIndex")
                .Where(w => w.Content != null && w.Content.IsVisible());

                resultsCount = searchResults.Count();
                }
                }

                @if (!string.IsNullOrEmpty(heroOverlayColour))
                {
                <style>
                    .home-hero > .overlay {
                        background-color: #@heroOverlayColour;
                        opacity: 0.5;
                    }

                    .home-hero {
                        background-repeat: no-repeat;
                    }
                </style>
                }

                <section class="container my-5">
                    <h1 class="mb-4">Search</h1>

                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                    <div class="row">
                        <div class="col">
                            @if (resultsCount == 0)
                            {
                            <p>No results were found for "<strong>@searchQuery</strong>".</p>
                            }
                            else
                            {
                            <p>We found <strong>@resultsCount</strong> result(s) for "<strong>@searchQuery</strong>":</p>
                            <ul class="list-unstyled">
                                @foreach (var result in searchResults)
                                {
                                var page = result.Content;
                                <li class="mb-4">
                                    <h4><a href="@page.Url">@page.Name</a></h4>
                                    @if (page.HasValue("metaDescription"))
                                    {
                                    <p>@page.Value("metaDescription")</p>
                                    }
                                </li>
                                }
                            </ul>
                            }
                        </div>
                    </div>
                    }
                    else
                    {
                    <p>Please enter a search term above.</p>
                    }
                </section>
