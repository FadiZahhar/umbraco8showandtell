@inherits Umbraco.Web.Mvc.UmbracoViewPage


    <footer class="main-footer py-5 bg-light text-dark">
        <div class="container">
            <div class="row"> <!-- Company Details -->
                <div class="col-md-3 mb-4 mb-md-0">
                    <h6 class="font-weight-bold">Company Details</h6>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2"> <a href="/about" class="text-dark">About us</a> </li>
                        <li class="mb-2"> <a href="/services" class="text-dark">Our Services</a> </li>
                        <li class="mb-2"> <a href="/care" class="text-dark">Customer Care</a> </li>
                        <li class="mb-2"> <a href="/categories" class="text-dark">Categories</a> </li>
                        <li class="mb-2"> <a href="/contact" class="text-dark">Contact us</a> </li>
                    </ul>
                </div> <!-- Social Media -->
                <div class="col-md-3 mb-4 mb-md-0 text-center">
                    <h6 class="font-weight-bold">Follow us on</h6>
                    <div class="d-flex justify-content-center flex-wrap mt-3"> <a href="https://facebook.com" class="social-icon mx-2 mb-2" aria-label="Facebook"> <img src="/media/eirphesv/facebook.svg" alt="Facebook" width="32" height="32" loading="lazy"> </a><a href="https://youtube.com" class="social-icon mx-2 mb-2" aria-label="YouTube"> <img src="/media/pewgqsgi/youtube.svg" alt="YouTube" width="32" height="32" loading="lazy"> </a><a href="https://linkedin.com" class="social-icon mx-2 mb-2" aria-label="LinkedIn"> <img src="/media/oeconfc4/linkedin.svg" alt="LinkedIn" width="32" height="32" loading="lazy"> </a><a href="https://instagram.com" class="social-icon mx-2 mb-2" aria-label="Instagram"> <img src="/media/0sgih5fk/instagram.svg" alt="Instagram" width="32" height="32" loading="lazy"> </a><a href="https://gmail.com" class="social-icon mx-2 mb-2" aria-label="Gmail"> <img src="/media/sstd513z/gmail.svg" alt="Gmail" width="32" height="32" loading="lazy"> </a> </div>
                </div> <!-- Payment Methods -->
                <div class="col-md-3 mb-4 mb-md-0 text-center">
                    <h6 class="font-weight-bold">We accept</h6>
                    <div class="d-flex justify-content-center flex-wrap mt-3">
                        <div class="payment-icon mx-2 mb-2"> <img src="/media/nluh2o5w/visa.png?width=500&mode=max&animationprocessmode=first" alt="Visa" width="48" height="32" loading="lazy"> </div>
                        <div class="payment-icon mx-2 mb-2"> <img src="/media/gntnoajb/ewallet.png?width=500&mode=max&animationprocessmode=first" alt="E-wallet" width="48" height="32" loading="lazy"> </div>
                        <div class="payment-icon mx-2 mb-2"> <img src="/media/c4ljujrm/card.png?width=500&mode=max&animationprocessmode=first" alt="Card" width="48" height="32" loading="lazy"> </div>
                    </div>
                </div> <!-- Newsletter -->
                <div class="col-md-3">
                    <h6 class="font-weight-bold">Get Newsletters</h6>
                  @Html.Partial("NewsletterForm")
                </div>
            </div> <!-- Footer Bottom -->
            <div class="text-center mt-4 small text-muted"> © 2009–2024 ShopBaz All Rights Reserved </div>
        </div>
    </footer>