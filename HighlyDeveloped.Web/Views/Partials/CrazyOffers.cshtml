@using System
@inherits Umbraco.Web.Mvc.UmbracoViewPage

@{
    Layout = null;

    var title   = Model.Value<string>("title");
    var subject = Model.Value<string>("subject");
    var offer   = Model.Value<string>("offer");
    var checkOut = Model.Value<string>("checkOut");

    // Date Picker with time property
    var endAt = Model.Value<DateTime?>("endAt"); 
    var endIsoUtc = endAt?.ToUniversalTime().ToString("o"); // ISO UTC format
}

<section class="crazy-offers" id="CrazyOffers">
  <div class="container">
    <!-- Section Header -->
    <div class="row">
      <div class="col-12">
        <div class="section-header">
          <h1>@title</h1>
        </div>
      </div>
    </div>

    <div class="row crazy-box rounded shadow p-3 mx-1 p-lg-5">
      <div class="col-12 col-lg-6 d-flex flex-column justify-content-center">
          <h4 class="mb-3 mb-lg-5" data-aos="zoom-out">@subject</h4>
          <h1 data-aos="zoom-out">Hurry up! Offer ends in</h1>
          <h2 class="get-up mb-3 mb-lg-5" data-aos="zoom-out">@offer</h2>

          <div class="d-flex flex-row" id="countdown" data-end-utc="@endIsoUtc">
            <p class="d-flex flex-column align-items-center justify-content-center bubble shadow" data-unit="days" data-aos="fade-up" data-aos-delay="200">
              <span class="value">00</span>
              <span>Days</span>
            </p>
            <p class="d-flex flex-column align-items-center justify-content-center bubble shadow" data-unit="hours" data-aos="fade-up" data-aos-delay="300">
              <span class="value">00</span>
              <span>Hours</span>
            </p>
            <p class="d-flex flex-column align-items-center justify-content-center bubble shadow" data-unit="minutes" data-aos="fade-up" data-aos-delay="400">
              <span class="value">00</span>
              <span>Mins</span>
            </p>
            <p class="d-flex flex-column align-items-center justify-content-center bubble shadow" data-unit="seconds" data-aos="fade-up" data-aos-delay="500">
              <span class="value">00</span>
              <span>Sec</span>
            </p>
          </div>

          <div class="text-centerr" data-aos="zoom-in">
            <a href="@checkOut" class="check-out mt-3 mt-lg-5 py-3 px-4 rounded">Check Out</a>
          </div>
      </div>

      <div class="col-12 col-lg-6 d-flex flex-column align-items-center justify-content-center">
          <img src="@Url.Content("~/media/3ralfdpb/shopping-cart.png")" class="img-fluid" width="418" data-aos="zoom-out" />
      </div>
    </div>
  </div>
</section>


