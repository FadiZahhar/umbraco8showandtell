@*
    Renders a responsive navigation bar using Bootstrap classes.
    - Inherits from UmbracoViewPage to access Umbraco content features.
    - Retrieves the home page node using Model.AncestorOrSelf<Home>().
    - Iterates through the direct children of the home page to generate navigation links.
    - Each child page is rendered as a navigation item with its name and URL.
    - The navigation bar is styled with Bootstrap's dark theme and is mobile-friendly with a collapsible menu.
*@
@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
    var homePage = Model.AncestorOrSelf<Home>();
}

  <header class="main-header sticky-top bg-white">
        <div class="container py-3">
            <div class="d-flex align-items-center justify-content-between"> <!-- Logo and text (always visible) -->
                <div class="d-flex d-lg-none align-items-center "> 
                <img src="/media/2t2hxqil/shop-logo.svg" alt="ShopBazar" width="60" class="mr-2">
                    <h5 class="mb-0 ms-3">ShopBazar</h5>
                </div> <!-- Burger button (visible on md and below) --> <button class="navbar-toggler d-lg-none" type="button" data-toggle="collapse" data-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle navigation"> <i class="fas fa-bars"></i> </button>
            </div>
        </div> <!-- Collapsible menu (hidden on desktop, shown on toggle for mobile/tablet) -->
        <div class="collapse d-lg-block" id="mobileMenu">
            <div class="container">
                <div class="row mt-3">
                    <div class="col-lg-4 mt-4 mt-lg-0 d-none d-lg-block">
                        <div class="d-flex align-items-center"> <img src="/media/2t2hxqil/shop-logo.svg" alt="ShopBazar" width="60" class="mr-2">
                            <h5 class="mb-0 ms-3">ShopBazar</h5>
                        </div>
                    </div>
                     <div class="col-lg-5 mt-4 mt-lg-0 d-flex align-items-center">
                      <form method="get" action="/search" class="w-100 mb-0">
                        <div class="input-group py-1">
                          <input type="text" class="form-control" name="q" placeholder="Search..." aria-label="Search" required>
                          <div class="input-group-append">
                            <button class="btn" type="submit">
                              <i class="fas fa-search"></i>
                            </button>
                          </div>
                        </div>
                      </form>
                    </div>
                    <div class="col-lg-3 mt-4 mt-lg-0 d-flex align-items-center justify-content-lg-end">
                        <div class="d-flex align-items-center"> 
                        <!-- User icon with dropdown login form -->
            <div class="dropdown login-dropdown mx-2">
              <a
                class="dropdown-toggle text-dark"
                href="#"
                id="loginDropdown"
                role="button"
                data-toggle="dropdown"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <img
                  src="/media/qtpjw5th/user.svg"
                  alt="User"
                  width="30"
                  height="30"
                />
              </a>
              <div
                class="dropdown-menu dropdown-menu-right p-3"
                aria-labelledby="loginDropdown"
                style="min-width: 250px;"
              >
                @if (Umbraco.MemberIsLoggedOn())
                {
                  var member = Members.GetCurrentMember();
                  <p class="mb-2">Welcome, <strong>@member.Name</strong></p>
                  <a href="/logout" class="btn btn-danger btn-block">Log out</a>
                }
                else
                {
                  <form method="post" action="/umbraco/Surface/Login/HandleLogin">
                    @Html.AntiForgeryToken()
                    <input
                      type="text"
                      name="Username"
                      class="form-control mb-2"
                      placeholder="Username"
                      required
                    />
                    <input
                      type="password"
                      name="Password"
                      class="form-control mb-2"
                      placeholder="Password"
                      required
                    />
                    <input type="hidden" name="RedirectUrl" value="/" />
                    <button
                      type="submit"
                      class="btn btn-primary btn-block"
                    >
                      Login
                    </button>
                  </form>
                  <div class="mt-2 text-center small">
                    <a href="/forgotten-password/">Forgot password?</a><br />
                    <a href="/register/">Register</a>
                  </div>
                }
              </div>
            </div>

                   <a href="@(Umbraco.MemberIsLoggedOn() ? "/cart" : "/login?redirect=/cart")" class="text-dark mx-2" aria-label="icon"> <img src="/media/ublpvxtc/cart.svg" alt="" width="30" height="30"> </a><a href="@(Umbraco.MemberIsLoggedOn() ? "/wishlist" : "/login?redirect=/wishlist")" class="text-dark mx-2" aria-label="icon"> <img src="/media/gibhdl5i/heart.svg" alt="" width="30" height="30"> </a><a href="/support" class="text-dark mx-2" aria-label="icon"> <img src="/media/4esna0pq/headphones.svg" alt="" width="30" height="30"> </a><a href="/language" class="text-dark mx-2" aria-label="icon"> <img src="/media/dszac2j3/globe.svg" alt="" width="30" height="30"> </a> </div>
                    </div> <!-- Nav Links and Dropdown -->
                    <nav class="mt-3 mb-4 w-100">
                        <div class="d-flex align-items-center py-2 justify-content-xl-between flex-wrap"> <!-- Category Dropdown -->
                            <div class="dropdown"> <button class="btn btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Category
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton"> <a class="dropdown-item" href="#">Clothing</a> <a class="dropdown-item" href="#">Electronics</a> <a class="dropdown-item" href="#">Furniture</a> </div>
                            </div> <!-- Horizontal Nav Menu --> <a href="/new" class=" mx-2">New</a><a href="/sales" class=" mx-2">Sales</a><a href="/trending" class=" mx-2">Trending</a><a href="/featured" class=" mx-2">Featured</a><a href="/fashion" class=" mx-2">Fashion</a><a href="/jewellery" class=" mx-2">Jewellery</a><a href="/watch" class=" mx-2">Watch</a><a href="/gadgets" class=" mx-2">Gadgets</a><a href="/home-decor" class=" mx-2">Home Decor</a><a href="/home-accessories" class=" mx-2">Home Accessories</a><a href="/foods" class=" mx-2">Foods</a>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>
    
