@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using ContentModels = Umbraco.Web.PublishedModels;
@using Umbraco.Core.PropertyEditors.ValueConverters;



@{
	var dealCards = Umbraco.Content(Guid.Parse("19cc5eee-e050-41e6-87c2-6acc96bdd0ed"))
    .ChildrenOfType("hotDealArticle")
    .Where(x => x.IsVisible());
}


<section id="hot-deals" class="hot-deals section">
    <div class="container hot-deals__head">
        <div class="row">
            <div class="col text-start">
                <h1>Hot Deals</h1>
            </div>
            <div class="col text-end">
                <a href="/ecommerce">View All</a>
            </div>
        </div>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="swiper init-swiper">
            <script type="application/json" class="swiper-config">
                {
                    "loop": true,
                    "speed": 600,
                    "autoplay": { "delay": 5000 },
                    "spaceBetween": 16,
                    "slidesPerView": 1,
                    "breakpoints": {
                        "480": { "slidesPerView": 1.2 },
                        "768": { "slidesPerView": 2 },
                        "992": { "slidesPerView": 3 },
                        "1200": { "slidesPerView": 3.5 }
                    },
                    "pagination": { "el": ".swiper-pagination", "type": "bullets", "clickable": true },
                    "navigation": { "nextEl": ".swiper-button-next", "prevEl": ".swiper-button-prev" }
                }
            </script>

            <div class="swiper-wrapper">
                @foreach (var item in dealCards)
                {
                var image = item.Value<ImageCropperValue>
                    ("productImage");
                    var thumbUrl = image.Src + image.GetCropUrl("Thumb");

                    var title = item.Value<string>
                        ("title");
                        var rating = item.Value<decimal?>
                            ("ratings") ?? 0;
                            var sizes = item.Value<string>
                                ("size");
                                var oldPrice = item.Value<decimal?>
                                    ("oldPrice");
                                    var newPrice = item.Value<decimal?>
                                        ("newPrice");

                                        <!--SIZES NESTED CONTENT-->
                                        <!--var productSizes = item.Value<IEnumerable<IPublishedElement>>("productSizesNestedContent");-->
                                        var productSizes = item.Value<IEnumerable<IPublishedElement>>("productSizesNestedContent");
                        var sizeLabels = productSizes?.Select(x => x.Value<string>("size")) ?? Enumerable.Empty<string>();



                        <!--PRODUCTS COLOR -->
                        var images = item.Value<IEnumerable<IPublishedContent>>("colors");


                        <div class="swiper-slide">
                            <a href="@item.Url" style="text-decoration:none; color:inherit;">
                            <article class="deal-card">
                                <div class="card">
                                    <img src="@thumbUrl" class="card-img" alt="@title" />
                                    <div class="card-img-overlay card-text-style">
                                        <div class="row mb-1">
                                            <div class="col text-start">
                                                <h5>@title</h5>
                                            </div>
                                            <div class="col text-end">
                                                <div class="rating">

                                                                <img src="/media/xaxj1pgm/ratings.png" alt="" />


                                                    <span>@rating.ToString("0.0")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-1">
                                            <div class="col text-start">
                                                   @if (productSizes != null && productSizes.Any())
                                                   {
                                                     <p>@string.Join(" - ", sizeLabels)</p>
                                                   }
                                            </div>
                                            <div class="col text-end old-price">
                                                <p>$@oldPrice</p>
                                            </div>
                                        </div>

                                        <div class="row">

                                                @if (images != null)
                                                    {

                                                            <div class="col text-start colors">

                                                                @foreach (var img in images)
                                                                {

                                                                        <img src="@img.Url()" alt="@img.Name" />

                                                                }


                                                        </div>
                                                    }
                                                <div class="col new-price text-end">
                                                    <span>$@newPrice</span>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                            </a>
                        </div>
                    }
            </div>

            <div class="hot-deals__controls">
                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        </div>
    </div>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".init-swiper").forEach(function (swiperEl) {
            const configScript = swiperEl.querySelector(".swiper-config");
            if (!configScript) return;

            try {
                const config = JSON.parse(configScript.textContent);
                new Swiper(swiperEl, config);
            } catch (e) {
                console.error("Failed to parse Swiper config:", e);
            }
        });
    });
</script>



