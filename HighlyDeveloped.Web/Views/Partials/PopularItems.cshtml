@inherits Umbraco.Web.Mvc.UmbracoViewPage
@using Umbraco.Core.PropertyEditors.ValueConverters;
@{ 
    
    var articles = Umbraco.ContentAtRoot().DescendantsOrSelfOfType("hotDealsArticles").FirstOrDefault();
    var news = articles.Children;
    
    if(!string.IsNullOrEmpty(Request.QueryString["cat"]))
    {
        news = articles.Children.Where(w => w.Value<string[]>("tagHotDealArticle").Contains(Request.QueryString["cat"]));
    }
    
     var selectedCat = Request.QueryString["cat"];
    
    
    // Take only the first 15 articles if they exist
    news = news.Take(15).ToList();

	
	var tags = articles.Children.Select(w => w.Value<string[]>("tagHotDealArticle"));
	var categoryList = new List<string>();
	foreach(var tagArray in tags)
	{
	    foreach(var tag in tagArray){
	        if(!categoryList.Contains(tag)){
	            categoryList.Add(tag);
	        }
	    }
	}
}

<!-- News Article -->


<section class="popular-items"  id="popular-items">
  <div class="container popularItems__head">
    <!-- Section Header -->
   
        <div class="row">
      <div class="col-12">
        <div class="section-header">
          <h2>Popular Items</h2>
          <a href={data.ctaButton.url} class="view-all">View All</a>
        </div>
      </div>
    </div>
  
    
    <!-- Category Filter -->
    <div class="row">
    <div class="col-12">
        <div class="category-filter">
            <div class="filter-scroll">
                 @foreach (var category in categoryList.OrderBy(o => o))
    {
        var isActive = string.IsNullOrEmpty(selectedCat)
            ? category == categoryList.First()
            : category == selectedCat;

        <a href="@Model.Url?cat=@category"
           class="filter-btn @(isActive ? "active" : "")"
           data-filter="@category"
           aria-label="Filter by @category">
           @category
        </a>
    }
            </div>
        </div>
    </div>
</div>

    
    <!-- Products Grid -->
    <div class="row products-grid">
      @foreach (var article in news)
      {
          var productTitle = article.Value<string>("title");
        var price = article.Value<decimal>("newPrice");
          var originalPrice = article.Value<decimal>("oldPrice");
          var rating = article.Value<decimal>("ratings");
          
          
          var image = article.Value<ImageCropperValue>
                    ("productImage");
                    var thumbUrl = image.Src + image.GetCropUrl("Thumb");
                    
          <div class="col product-column">
            <div class="product-card" data-category="category">
              <div class="product-image">
                <img 
                    src="@thumbUrl" 
                    alt="productTitle" 
                    loading="lazy" />
                <div class="product-details">
                  <div class="product-header">
                    <h3 class="product-title" title="@productTitle">@productTitle</h3>
                    <div class="product-rating">
                      <i class="fas fa-star star"></i>
                      <span class="rating-value">@rating.ToString("0.0")</span>
                    </div>
                  </div>
                  <div class="product-footer">
                    <div class="product-price">
                      <span class="current-price">$ @price.ToString("0.00")</span>
                      <!--if (originalPrice > 0)-->
                      <!--{-->
                      <!--    <span class="original-price">$ originalPrice.ToString("0.00")</span>-->
                      <!--}-->
                    </div>
                    <button 
                        class="btn-buy"
                        type="button"
                        data-product-id="article.Id"
                        aria-label="Buy productTitle">
                        Buy
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
      }
    </div>

    <!-- CTA Button -->
  
        <div class="row">
          <div class="col-12">
            <div class="cta-section">
              <a href="ctaButton.Url" class="btn-view-all">
                View All
              </a>
            </div>
          </div>
        </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".filter-btn");

    buttons.forEach(btn => {
        btn.addEventListener("click", function () {
            // Remove active from all buttons
            buttons.forEach(b => b.classList.remove("active"));
            // Add active to clicked button
            this.classList.add("active");
        });
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // Scroll to the popular-items section
    const popularSection = document.getElementById("popular-items");
    if (popularSection) {
        popularSection.scrollIntoView({ behavior: "smooth" });
    }

    // Filter buttons behavior
    const buttons = document.querySelectorAll(".filter-btn");
    buttons.forEach(btn => {
        btn.addEventListener("click", function () {
            buttons.forEach(b => b.classList.remove("active"));
            this.classList.add("active");
        });
    });
});
</script>
